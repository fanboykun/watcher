{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun run check:structure && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun run check:structure && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "bun run check:structure && prettier --check . && eslint .",
		"format": "prettier --write .",
		"check:structure": "bun scripts/check-structure.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@fontsource-variable/manrope": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.18.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^24",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-xml": "^6.1.0",
		"@codemirror/language": "^6.13.1",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/merge": "^6.12.3",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@lezer/highlight": "^1.2.5",
		"@tanstack/query-core": "5.104.5",
		"@tanstack/svelte-query": "6.3.5",
		"codemirror": "^6.0.2",
		"filesize": "^11.0.13"
	}
}
