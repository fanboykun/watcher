# Watcher Agent environment configuration
# Copy this file to .env and fill in your values.

# Label for this environment (informational only)
ENVIRONMENT=production

# GitHub Personal Access Token (PAT)
# Required for private repos (scope: repo or contents:read)
# Leave empty for public repos
GITHUB_TOKEN=

# Directory for agent log files
LOG_DIR=D:\apps\watcher\logs

# Structured JSON logging and rotation (size is megabytes, age is days)
LOG_LEVEL=info
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=10
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true

# Path to NSSM executable (installed by install-watcher.ps1)
NSSM_PATH=C:\ProgramData\chocolatey\bin\nssm.exe

# SQLite database file path
DB_PATH=D:\apps\watcher\watcher.db

# API server port (dashboard + REST API)
API_PORT=8080

# Externally reachable base URL for this watcher instance
# Required for GitHub Deployment API integration (deployment log UI URLs)
# Leave empty to disable GitHub Deployment status reporting
API_BASE_URL=

# Base path for web dashboard and assets (useful behind reverse proxy subpaths)
# Example: /watcher (for https://sasad.socfindo.co.id/watcher)
# Leave empty to serve from root (/)
WEB_ASSETS_PATH=

# GitHub repository URL for the watcher project itself
# Used for self-update checks
WATCHER_REPO_URL=https://github.com/fanboykun/watcher

# NSSM service name for watcher itself
# Used by self-update/restart/uninstall actions
WATCHER_SERVICE_NAME=app-watcher
